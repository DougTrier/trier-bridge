[flake8]
max-line-length = 100
# CCR001 (cognitive complexity) is reported by tools/dev.py complexity, not by plain lint
extend-ignore = E203, W503, CCR001
exclude = .git,.venv,__pycache__,build,dist,reports,debian
per-file-ignores =
    tests/*: E501
    tools/env/tb-pad.py: E501
