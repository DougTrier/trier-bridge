# Trier Bridge Git attributes
# Stack-neutral baseline. Revisit after implementation/package formats are selected.

* text=auto eol=lf

*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Common binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.deb binary
*.rpm binary
*.AppImage binary
*.cmd text eol=crlf
*.bat text eol=crlf
